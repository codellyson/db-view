---
import MockShell from './MockShell.astro';

// Real query against the repo's SQLite fixture — the result rows below are
// what it actually returns for that seed data.
const results = [
  ['Linus Torvalds', '1', '674.0'],
  ['Ada Lovelace', '1', '129.99'],
  ['Alan Turing', '1', '79.5'],
];
---

<MockShell tabs={[
  { badge: 'T', label: 'users' },
  { badge: 'E', label: 'SQL Editor 1', active: true },
]}>
  <div class="flex min-h-0 flex-1 flex-col">
    <div class="flex items-center gap-2 border-b border-border px-3 py-1.5">
      <span class="rounded-md bg-accent px-2 py-1 text-[10px] font-medium text-accent-text">Run ⌘↵</span>
      <span class="rounded-md border border-border px-2 py-1 text-[10px] text-secondary">Format</span>
      <span class="rounded-md border border-border px-2 py-1 text-[10px] text-secondary">Explain</span>
      <span class="rounded-md border border-border px-2 py-1 text-[10px] text-secondary">Save</span>
      <span class="ml-auto text-[10px] text-muted">History</span>
    </div>

    <pre class="overflow-hidden px-3 py-3 font-mono text-[11px] leading-[1.75]"><code><span class="text-muted/60">-- top customers by paid revenue</span>
<span class="text-accent">select</span> u.name,
       <span class="text-accent">count</span>(o.id)                <span class="text-accent">as</span> orders,
       <span class="text-accent">sum</span>(o.total_cents) / <span class="text-warning">100.0</span> <span class="text-accent">as</span> revenue
<span class="text-accent">from</span> users u
<span class="text-accent">join</span> orders o <span class="text-accent">on</span> o.user_id = u.id
<span class="text-accent">where</span> o.status <span class="text-accent">in</span> (<span class="text-success">'paid'</span>, <span class="text-success">'shipped'</span>)
<span class="text-accent">group by</span> u.name
<span class="text-accent">order by</span> revenue <span class="text-accent">desc</span>;</code></pre>

    <div class="mt-auto border-t border-border">
      <div class="flex items-center gap-2 border-b border-border px-3 py-1.5">
        <span class="rounded-sm bg-bg-secondary px-1.5 py-0.5 font-mono text-[9px] text-muted">R</span>
        <span class="text-[10px] text-secondary">3 rows returned</span>
        <span class="font-mono text-[10px] text-muted">· 4 ms</span>
        <span class="ml-auto rounded-md border border-border px-2 py-0.5 text-[10px] text-secondary">Export</span>
      </div>
      <div class="mock-grid">
        <table class="w-full border-collapse text-left font-mono text-[10px]">
          <thead>
            <tr class="bg-bg-secondary/60">
              <th class="w-7 border-b border-border px-2 py-1.5"></th>
              {['name', 'orders', 'revenue'].map((c) => (
                <th class="border-b border-border px-2 py-1.5 font-sans text-[10px] font-medium text-secondary">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {results.map((row, i) => (
              <tr class="border-b border-border/60">
                <td class="px-2 py-[7px] text-right text-[9px] text-muted/70">{i + 1}</td>
                {row.map((cell) => (
                  <td class="whitespace-nowrap px-2 py-[7px] text-secondary">{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</MockShell>
