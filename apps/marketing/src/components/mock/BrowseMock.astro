---
import MockShell from './MockShell.astro';

// Straight out of scripts/fixtures/seed-sqlite.sql.
const columns = [
  { name: 'id', type: 'INTEGER' },
  { name: 'email', type: 'TEXT' },
  { name: 'name', type: 'TEXT' },
  { name: 'is_active', type: 'INTEGER' },
  { name: 'bio', type: 'TEXT' },
  { name: 'created_at', type: 'TEXT' },
];
const rows = [
  ['1', 'ada@example.com', 'Ada Lovelace', '1', 'Mathematician', '2026-05-08 10:03:53'],
  ['2', 'alan@example.com', 'Alan Turing', '1', 'Cryptanalyst', '2026-05-08 10:03:53'],
  ['3', 'grace@example.com', 'Grace Hopper', '1', null, '2026-05-08 10:03:53'],
  ['4', 'linus@example.com', 'Linus Torvalds', '1', 'Kernel hacker', '2026-05-08 10:03:53'],
  ['5', 'dormant@example.com', 'Dormant Account', '0', null, '2026-05-08 10:03:53'],
];
---

<MockShell tabs={[
  { badge: 'T', label: 'orders' },
  { badge: 'T', label: 'products' },
  { badge: 'T', label: 'users', active: true },
]}>
  <div class="flex min-h-0 flex-1 flex-col px-4 py-3">
    <p class="font-mono text-[10px] text-muted">
      justdb-test <span class="opacity-50">›</span> main <span class="opacity-50">›</span>
      <span class="text-secondary">users</span>
    </p>
    <h3 class="mt-2 text-[17px] font-semibold tracking-tight text-primary">users</h3>

    <div class="mt-3 flex items-center gap-2">
      <span class="rounded-md border border-border px-2 py-1 text-[10px] text-secondary">Columns</span>
      <span class="flex-1 rounded-md border border-border px-2 py-1 text-[10px] text-muted">Search rows…</span>
      <span class="rounded-md border border-border px-2 py-1 text-[10px] text-secondary">Import CSV</span>
      <span class="rounded-md border border-border px-2 py-1 text-[10px] text-secondary">Export</span>
    </div>

    <div class="mock-grid mt-3 rounded-md border border-border">
      <table class="w-full border-collapse text-left font-mono text-[10px]">
        <thead>
          <tr class="bg-bg-secondary/60">
            <th class="w-7 border-b border-border px-2 py-1.5"></th>
            <th class="w-7 border-b border-border px-1 py-1.5"></th>
            {columns.map(({ name, type }) => (
              <th class="border-b border-border px-2 py-1.5 align-top">
                <span class="block font-sans text-[10px] font-medium text-secondary">{name}</span>
                <span class="block text-[8px] uppercase tracking-wide text-muted/70">{type}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class="border-b border-border/60">
              <td class="px-2 py-[7px] text-right text-[9px] text-muted/70">{i + 1}</td>
              <td class="px-1 py-[7px]">
                <span class="block h-2.5 w-2.5 rounded-[2px] border border-border-strong"></span>
              </td>
              {row.map((cell) => (
                <td class="whitespace-nowrap px-2 py-[7px]">
                  {cell === null ? (
                    <span class="italic text-muted/60">NULL</span>
                  ) : (
                    <span class="text-secondary">{cell}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
          <tr>
            <td class="px-2 py-[7px] text-center text-[10px] text-success">+</td>
            <td></td>
            {columns.map(() => (
              <td class="px-2 py-[7px] italic text-muted/40">NULL</td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-2.5 flex items-center gap-2 text-[10px] text-muted">
      <span>Showing 1–5 of 5 rows</span>
      <span class="rounded border border-border px-1.5 py-0.5 text-secondary">100 rows ▾</span>
      <span class="ml-auto flex items-center gap-1">
        <span>Prev</span>
        <span class="rounded bg-accent px-1.5 py-0.5 text-accent-text">1</span>
        <span>Next</span>
      </span>
    </div>

    <div class="mt-3 flex items-center gap-4 border-t border-border pt-2.5 text-[10px]">
      <span class="text-secondary">Schema <span class="text-muted">(7)</span></span>
      <span class="text-muted">Stats</span>
    </div>
  </div>
</MockShell>
