---
/*
 * A faithful, live-HTML rendering of the JustDB window: sidebar, header,
 * tab strip. Everything it shows comes from the repo's own SQLite fixture
 * (scripts/fixtures/seed-sqlite.sql), so the copy on this page never depicts
 * a feature or a shape the app doesn't have.
 */
interface Tab {
  badge: 'T' | 'E' | 'V';
  label: string;
  active?: boolean;
}
interface Props {
  tabs: Tab[];
  connection?: string;
  /** Hide the sidebar on small screens; showcase panels want the pane itself. */
  class?: string;
}
const { tabs, connection = 'justdb-test', class: className = '' } = Astro.props;

const recent = [
  { name: 'users', rows: 5 },
  { name: 'orders', rows: 5 },
  { name: 'products', rows: 4 },
];
const all = [
  { name: 'order_items', rows: 5 },
  { name: 'orders', rows: 5 },
  { name: 'posts', rows: 5 },
  { name: 'products', rows: 4 },
  { name: 'users', rows: 5 },
];
const views = ['active_users', 'recent_orders'];

const activeTable = tabs.find((t) => t.active)?.label ?? 'users';
---

<div class={`flex h-full bg-bg ${className}`}>
  <aside class="hidden w-[188px] shrink-0 flex-col border-r border-border bg-bg-secondary/40 lg:flex">
    <div class="flex items-center justify-between px-2.5 py-2">
      <span class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted">Tables <span class="text-muted/70">5</span></span>
      <span class="rounded px-1.5 py-0.5 text-[10px] text-muted">Group</span>
    </div>
    <div class="px-2 pb-2">
      <div class="flex items-center gap-1.5 rounded-md border border-border bg-bg px-2 py-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-muted" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round"></line>
        </svg>
        <span class="text-[11px] text-muted">Search tables…</span>
      </div>
    </div>

    <div class="px-2.5 pb-1 pt-1 text-[9px] font-medium uppercase tracking-[0.1em] text-muted/70">Recent</div>
    <ul class="px-1.5">
      {recent.map(({ name, rows }) => (
        <li
          class={`flex items-center gap-1.5 rounded px-2 py-[5px] text-[11px] ${
            name === activeTable ? 'bg-accent/10 text-accent' : 'text-secondary'
          }`}
        >
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 opacity-70" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <line x1="3" y1="9.5" x2="21" y2="9.5"></line>
          </svg>
          <span class="truncate">{name}</span>
          <span class="ml-auto text-[9px] text-muted/70">{rows}</span>
        </li>
      ))}
    </ul>

    <div class="px-2.5 pb-1 pt-3 text-[9px] font-medium uppercase tracking-[0.1em] text-muted/70">All tables</div>
    <ul class="px-1.5">
      {all.map(({ name, rows }) => (
        <li
          class={`flex items-center gap-1.5 rounded px-2 py-[5px] text-[11px] ${
            name === activeTable ? 'bg-accent/10 text-accent' : 'text-secondary'
          }`}
        >
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 opacity-70" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <line x1="3" y1="9.5" x2="21" y2="9.5"></line>
          </svg>
          <span class="truncate">{name}</span>
          <span class="ml-auto text-[9px] text-muted/70">{rows}</span>
        </li>
      ))}
    </ul>

    <div class="px-2.5 pb-1 pt-3 text-[9px] font-medium uppercase tracking-[0.1em] text-muted/70">Views <span class="opacity-70">2</span></div>
    <ul class="px-1.5">
      {views.map((name) => (
        <li class="flex items-center gap-1.5 rounded px-2 py-[5px] text-[11px] text-secondary">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 opacity-70" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <line x1="3" y1="9.5" x2="21" y2="9.5"></line>
          </svg>
          <span class="truncate">{name}</span>
        </li>
      ))}
    </ul>

    <div class="mt-auto px-2.5 py-2 font-mono text-[9px] text-muted/60">v0.2.3</div>
  </aside>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex h-11 shrink-0 items-center gap-2 border-b border-border px-3">
      <img src="/logo.svg" alt="" width="16" height="16" class="rounded-[3px]" aria-hidden="true" />
      <span class="text-[12px] font-semibold tracking-tight text-primary">JustDB</span>
      <div class="ml-auto flex items-center gap-2">
        <span class="flex items-center gap-1.5 rounded-md border border-border px-2 py-1 text-[10px] text-secondary">
          <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
          {connection}
        </span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-muted" aria-hidden="true">
          <circle cx="12" cy="12" r="3.2"></circle>
          <circle cx="12" cy="12" r="9"></circle>
        </svg>
      </div>
    </div>

    <div class="flex h-8 shrink-0 items-stretch border-b border-border bg-bg-secondary/30">
      <div class="flex items-center gap-1.5 border-r border-border px-2 text-[11px] text-muted">
        <span>+</span>
        <span class="text-accent">AI</span>
      </div>
      {tabs.map(({ badge, label, active }) => (
        <div
          class={`flex items-center gap-1.5 border-r border-border px-2.5 text-[11px] ${
            active ? '-mb-px border-b-2 border-b-accent bg-bg text-primary' : 'text-muted'
          }`}
        >
          <span
            class={`rounded-sm px-1 font-mono text-[8px] ${
              active ? 'bg-accent/10 text-accent' : 'bg-bg-secondary text-muted'
            }`}
          >{badge}</span>
          <span>{label}</span>
          {active && <span class="text-muted">×</span>}
        </div>
      ))}
    </div>

    <slot />
  </div>
</div>
