---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppFrame from '../components/AppFrame.astro';
import BrowseMock from '../components/mock/BrowseMock.astro';
import QueryMock from '../components/mock/QueryMock.astro';
import EditMock from '../components/mock/EditMock.astro';
import { DATABASES, LAUNCH_URL, PLATFORMS, RELEASES_URL, REPO } from '../lib/site';
import { faqJsonLd, organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from '../lib/seo';

const downloadUrl = RELEASES_URL;

// Resolve direct installer URLs for the latest release at build time so the
// device-detected CTA links straight to the right file. Asset names carry the
// version (e.g. JustDB_0.2.3_x64-setup.exe), so we can't hardcode them — we
// match by extension against the latest release. Any failure or missing asset
// falls back to the releases page.
async function resolveDownloads(): Promise<Record<'macos' | 'windows' | 'linux', string>> {
  const fallback = { macos: downloadUrl, windows: downloadUrl, linux: downloadUrl };
  try {
    const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'justdb-marketing' },
    });
    if (!res.ok) return fallback;
    const { assets = [] } = (await res.json()) as {
      assets?: { name: string; browser_download_url: string }[];
    };
    const find = (re: RegExp) => assets.find((a) => re.test(a.name))?.browser_download_url;
    return {
      macos: find(/\.dmg$/i) ?? downloadUrl,
      // NSIS setup is the standard user installer; .msi is the fallback.
      windows: find(/-setup\.exe$/i) ?? find(/\.msi$/i) ?? downloadUrl,
      // Linux bundles aren't published — send them to the releases page.
      linux: downloadUrl,
    };
  } catch {
    return fallback;
  }
}
const downloads = await resolveDownloads();

const FEATURES = [
  {
    title: 'Browse your database',
    body: 'Tables, views, columns, indexes, foreign keys and row counts — laid out plainly instead of buried behind a terminal.',
    icon: 'table',
  },
  {
    title: 'Query without leaving the app',
    body: 'A real SQL editor with completion, formatting and EXPLAIN, and results in a grid you can keep working in.',
    icon: 'code',
  },
  {
    title: 'Edit records directly',
    body: 'Change a cell, add a row, delete one. Edits stage up first — review the exact SQL before anything is written.',
    icon: 'cell',
  },
  {
    title: 'Follow the relationships',
    body: 'Jump through a foreign key to the row it points at, and see what a delete would cascade to before you run it.',
    icon: 'schema',
  },
  {
    title: 'Find things fast',
    body: 'Filter tables, search rows, filter by column, and pull any query back out of history — no scrolling through a tree.',
    icon: 'search',
  },
  {
    title: 'Stay in control',
    body: 'A direct connection from your machine to your database. Passwords live in the OS keychain, not in a cloud account.',
    icon: 'lock',
  },
];

const WHY = [
  { title: 'Fast', body: 'Opens to your connections. Two clicks to rows.', icon: 'bolt' },
  { title: 'Simple', body: 'No dashboards, no workspaces, no onboarding tour.', icon: 'minus' },
  { title: 'Private', body: 'Direct connection. Credentials stay in your keychain.', icon: 'shield' },
  { title: 'Free', body: 'No account, no trial, no paid tier.', icon: 'free' },
  { title: 'Native', body: 'A real desktop app on macOS and Windows.', icon: 'screens' },
];

const AUDIENCE = [
  { title: 'Developers', body: 'Poke at a dev database without writing a throwaway script.' },
  { title: 'Backend engineers', body: 'Check a schema, chase a foreign key, verify a migration landed.' },
  { title: 'Indie hackers', body: 'Debug production data without installing a 400MB Java client.' },
  { title: 'Small teams', body: 'One simple tool everyone can use, with no seats to buy.' },
];

const FAQ = [
  {
    q: 'What databases does JustDB support?',
    a: 'PostgreSQL and SQLite, including remote libSQL/Turso databases over a libsql:// URL with an auth token. MySQL and MariaDB are planned — the option stays hidden in the app until the driver actually ships.',
  },
  {
    q: 'Is JustDB free?',
    a: 'Yes. No account, no trial, no paid tier, no upsell. It is built by KreativeKorna Concepts and released for free.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. There is no signup, no login and no sync service. Open the app, paste a connection string, and you are in.',
  },
  {
    q: 'Is my database uploaded anywhere?',
    a: 'No. JustDB opens a direct connection from your machine to your database — queries, schemas and rows never pass through a server we run. The app does send anonymous usage analytics (which features get used, and coarse timing buckets; never SQL, table names, file paths or row data), and you can switch that off in Settings.',
  },
  {
    q: 'Does JustDB store my database credentials?',
    a: 'Passwords and Turso auth tokens are written to your OS keychain — Keychain on macOS, Credential Manager on Windows, Secret Service on Linux. The non-secret parts of a saved connection (host, port, database name, username) sit in a plain JSON file in the app config directory. Neither is uploaded anywhere.',
  },
  {
    q: 'Can I connect to a remote database?',
    a: 'Yes. Any PostgreSQL you can reach over the network, with TLS when the server requires it, plus Turso/libSQL over an authenticated libsql:// URL.',
  },
  {
    q: 'Does it work with a database running in Docker?',
    a: 'Yes. A container is just a host and a port — point JustDB at localhost:5432 (or whatever you published) like any other server. Nothing Docker-specific to configure.',
  },
  {
    q: 'Can I use SSH tunnels?',
    a: 'Not built in yet. Open the tunnel yourself — ssh -L 5432:db.internal:5432 bastion — and connect JustDB to the forwarded local port.',
  },
  {
    q: 'Does JustDB use AI?',
    a: 'Only if you turn it on. There is an optional panel that drafts and explains SQL, and it stays inert until you add your own provider API key (kept in the OS keychain) or point it at a local Claude Code CLI. Nothing leaves your machine otherwise.',
  },
  {
    q: 'What operating systems are supported?',
    a: 'macOS as a universal build (Apple silicon and Intel) and Windows x64 as an .exe or .msi installer. Linux is not published as a bundle yet, though the repo builds from source on Linux.',
  },
  {
    q: 'Is there a cloud version?',
    a: 'No, and none is planned. JustDB is a desktop app that talks straight to your database — that is the whole point.',
  },
];

const supported = DATABASES.filter((d) => !d.planned);
const planned = DATABASES.filter((d) => d.planned);
---

<Layout jsonLd={[organizationJsonLd, websiteJsonLd, softwareApplicationJsonLd(), faqJsonLd(FAQ)]}>
  <Nav home />

  <main>
    <!-- ── Hero ──────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden">
      <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 h-[720px]" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute left-1/2 top-[-14rem] h-[36rem] w-[62rem] -translate-x-1/2 rounded-full opacity-[0.16] blur-3xl"
        style="background: radial-gradient(closest-side, rgb(var(--accent)), transparent);"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-shell px-5 pb-16 pt-16 sm:px-8 sm:pt-24">
        <div class="mx-auto max-w-4xl text-center">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-border bg-bg-secondary/60 px-3.5 py-1.5 text-[13px] text-secondary"
            data-reveal
          >
            <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
            A simple database client for developers
          </p>

          <h1
            class="mt-7 text-[clamp(2.6rem,7.2vw,5rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-primary"
            data-reveal
          >
            Your database, without<br class="hidden sm:block" /> the database drama.
          </h1>

          <p class="mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-secondary" data-reveal>
            Browse tables. Run queries. Edit records. Inspect relationships.
            JustDB is a small desktop app for working with your database — without
            the weight of a full database platform.
          </p>

          <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal>
            <Button
              size="lg"
              href={LAUNCH_URL}
              id="cta-open-app"
              data-fallback={downloadUrl}
              class="w-full sm:w-auto"
            >
              Open JustDB
              <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
            </Button>
            <Button
              size="lg"
              variant="secondary"
              href={downloadUrl}
              id="cta-download"
              external
              class="w-full sm:w-auto"
              data-download-macos={downloads.macos}
              data-download-windows={downloads.windows}
              data-download-linux={downloads.linux}
            >
              Download desktop app
            </Button>
          </div>

          <p class="mt-7 font-mono text-[13px] text-muted" data-reveal>
            PostgreSQL · SQLite · Turso
          </p>

          <ul
            class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[11px] font-medium uppercase tracking-[0.12em] text-muted"
            data-reveal
          >
            <li>Free forever</li>
            <li class="text-border-strong" aria-hidden="true">·</li>
            <li>No signup</li>
            <li class="text-border-strong" aria-hidden="true">·</li>
            <li>Local-first</li>
          </ul>
        </div>

        <div class="mt-14 sm:mt-20" data-reveal>
          <AppFrame class="mx-auto max-w-[1120px]">
            <div class="h-[480px] sm:h-[520px]">
              <BrowseMock />
            </div>
          </AppFrame>
        </div>
      </div>
    </section>

    <!-- ── Features ──────────────────────────────────────────────────────── -->
    <section id="features" class="scroll-mt-20 border-t border-border">
      <div class="mx-auto max-w-shell px-5 py-20 sm:px-8 sm:py-28">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Features</p>
          <h2 class="mt-3 text-[clamp(2rem,4.4vw,3.25rem)] font-semibold leading-[1.08] tracking-[-0.025em] text-primary">
            Everything you need.<br />Nothing you don't.
          </h2>
        </div>

        <ul class="mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
          {FEATURES.map(({ title, body, icon }) => (
            <li
              class="group relative bg-bg p-7 transition-colors duration-300 hover:bg-bg-secondary/50"
              data-reveal
            >
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-bg-secondary text-accent transition-transform duration-300 group-hover:-translate-y-0.5">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {icon === 'table' && (
                    <>
                      <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                      <line x1="3" y1="9" x2="21" y2="9"></line>
                      <line x1="9" y1="9" x2="9" y2="20"></line>
                    </>
                  )}
                  {icon === 'code' && (
                    <>
                      <polyline points="4 7 8 12 4 17"></polyline>
                      <line x1="12" y1="17" x2="20" y2="17"></line>
                    </>
                  )}
                  {icon === 'cell' && (
                    <>
                      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                      <line x1="12" y1="9" x2="12" y2="15"></line>
                      <line x1="10" y1="9" x2="14" y2="9"></line>
                      <line x1="10" y1="15" x2="14" y2="15"></line>
                    </>
                  )}
                  {icon === 'schema' && (
                    <>
                      <rect x="3" y="3" width="7" height="6" rx="1"></rect>
                      <rect x="14" y="15" width="7" height="6" rx="1"></rect>
                      <path d="M6.5 9v5a2 2 0 0 0 2 2H14"></path>
                    </>
                  )}
                  {icon === 'search' && (
                    <>
                      <circle cx="11" cy="11" r="7"></circle>
                      <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
                    </>
                  )}
                  {icon === 'lock' && (
                    <>
                      <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                      <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                    </>
                  )}
                </svg>
              </span>
              <h3 class="mt-5 text-[17px] font-medium tracking-tight text-primary">{title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-secondary">{body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Showcases ─────────────────────────────────────────────────────── -->
    <section class="border-t border-border">
      <div class="mx-auto max-w-shell space-y-24 px-5 py-20 sm:px-8 sm:py-28 lg:space-y-32">
        <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-14">
          <div data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Browse</p>
            <h2 class="mt-3 text-[clamp(1.75rem,3.4vw,2.6rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
              See your database clearly.
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-secondary">
              Every table, view, column and index in one pane. Pin the tables you
              live in, search the rest, and open as many as you want in tabs.
            </p>
            <ul class="mt-6 space-y-2.5 text-[14px] text-secondary">
              {['Tables and views with live row counts', 'Column types, nullability and defaults at a glance', 'Tabs, pinning and a searchable table list'].map((item) => (
                <li class="flex gap-3">
                  <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div data-reveal>
            <AppFrame>
              <div class="h-[460px]"><BrowseMock /></div>
            </AppFrame>
          </div>
        </div>

        <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-14">
          <div class="order-2 lg:order-1" data-reveal>
            <AppFrame>
              <div class="h-[460px]"><QueryMock /></div>
            </AppFrame>
          </div>
          <div class="order-1 lg:order-2" data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Query</p>
            <h2 class="mt-3 text-[clamp(1.75rem,3.4vw,2.6rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
              SQL when you need it.
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-secondary">
              Write it, run it, read the result — then keep going. Results land in
              the same grid as a table, so you can filter, sort and export them.
            </p>
            <ul class="mt-6 space-y-2.5 text-[14px] text-secondary">
              {['Syntax highlighting, completion and formatting', 'EXPLAIN plans without leaving the editor', 'Searchable history, plus queries you can save and name'].map((item) => (
                <li class="flex gap-3">
                  <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-14">
          <div data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Edit</p>
            <h2 class="mt-3 text-[clamp(1.75rem,3.4vw,2.6rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
              Edit data without the terminal.
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-secondary">
              Change a value in place, add a row, drop one. Nothing is written
              until you say so — edits stage up first, and you can read the exact
              SQL before it runs.
            </p>
            <ul class="mt-6 space-y-2.5 text-[14px] text-secondary">
              {['Staged changes with a Review SQL step', 'Cascade preview before a delete goes through', 'Import from CSV; export to CSV, JSON, SQL or Excel'].map((item) => (
                <li class="flex gap-3">
                  <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div data-reveal>
            <AppFrame>
              <div class="h-[460px]"><EditMock /></div>
            </AppFrame>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Why ───────────────────────────────────────────────────────────── -->
    <section class="border-t border-border">
      <div class="mx-auto max-w-shell px-5 py-20 sm:px-8 sm:py-28">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Why JustDB</p>
          <h2 class="mt-3 text-[clamp(2rem,4.4vw,3.25rem)] font-semibold leading-[1.08] tracking-[-0.025em] text-primary">
            Built for people who just want to see the damn database.
          </h2>
        </div>

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {WHY.map(({ title, body, icon }) => (
            <li
              class="rounded-xl border border-border bg-bg-secondary/40 p-6 transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-border-strong"
              data-reveal
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true">
                {icon === 'bolt' && <path d="M13 2 4 14h7l-1 8 9-12h-7z"></path>}
                {icon === 'minus' && (
                  <>
                    <circle cx="12" cy="12" r="9"></circle>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                  </>
                )}
                {icon === 'shield' && <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path>}
                {icon === 'free' && (
                  <>
                    <circle cx="12" cy="12" r="9"></circle>
                    <line x1="5.6" y1="5.6" x2="18.4" y2="18.4"></line>
                  </>
                )}
                {icon === 'screens' && (
                  <>
                    <rect x="2" y="5" width="13" height="9" rx="1"></rect>
                    <rect x="15" y="10" width="7" height="9" rx="1"></rect>
                  </>
                )}
              </svg>
              <h3 class="mt-4 text-[15px] font-medium text-primary">{title}</h3>
              <p class="mt-1.5 text-[13px] leading-relaxed text-muted">{body}</p>
            </li>
          ))}
        </ul>

        <!-- Positioning, stated as a contrast rather than a competitor table. -->
        <div class="mt-16 grid gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-center" data-reveal>
          <div class="rounded-xl border border-border bg-bg-secondary/30 p-7">
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Heavy database tools</p>
            <ul class="mt-4 space-y-2 text-[14px] text-muted">
              <li>Install, license, configure</li>
              <li>Nine panels you never open</li>
              <li>Enterprise-shaped by default</li>
              <li>A learning curve before a first query</li>
            </ul>
          </div>
          <div class="flex items-center justify-center py-2 text-2xl text-border-strong sm:px-2" aria-hidden="true">
            <span class="sm:hidden">↓</span>
            <span class="hidden sm:inline">→</span>
          </div>
          <div class="rounded-xl border border-accent/25 bg-accent/[0.04] p-7">
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-accent">JustDB</p>
            <ul class="mt-4 space-y-2 text-[14px] text-secondary">
              <li>Download, paste a URL, connect</li>
              <li>Tables, SQL, edits — that's the app</li>
              <li>Developer-shaped by default</li>
              <li>Rows on screen in under a minute</li>
            </ul>
          </div>
        </div>

        <p class="mt-8 text-[14px] text-muted" data-reveal>
          Coming from a heavier client? See how JustDB compares to
          <a href="/compare/dbeaver" class="text-secondary underline decoration-border-strong underline-offset-2 transition-colors hover:text-primary hover:decoration-accent">DBeaver</a>,
          <a href="/compare/pgadmin" class="text-secondary underline decoration-border-strong underline-offset-2 transition-colors hover:text-primary hover:decoration-accent">pgAdmin</a>
          and
          <a href="/compare/beekeeper-studio" class="text-secondary underline decoration-border-strong underline-offset-2 transition-colors hover:text-primary hover:decoration-accent">Beekeeper Studio</a>.
        </p>
      </div>
    </section>

    <!-- ── Databases ─────────────────────────────────────────────────────── -->
    <section id="databases" class="scroll-mt-20 border-t border-border">
      <div class="mx-auto max-w-shell px-5 py-20 sm:px-8 sm:py-28">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Supported databases</p>
          <h2 class="mt-3 text-[clamp(2rem,4.4vw,3.25rem)] font-semibold leading-[1.08] tracking-[-0.025em] text-primary">
            Works with your database.
          </h2>
          <p class="mt-5 text-[15px] leading-relaxed text-secondary">
            Local files, containers, and hosted servers alike. If MySQL is what
            you need, it is on the list — but it is not shipped yet, and this page
            is not going to pretend otherwise.
          </p>
        </div>

        <ul class="mt-12 grid gap-4 sm:grid-cols-3">
          {supported.map(({ name, note, tint }) => (
            <li
              class="flex items-center gap-4 rounded-xl border border-border bg-bg-secondary/40 p-6 transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-border-strong"
              data-reveal
            >
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke={`rgb(${tint})`}
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0"
                aria-hidden="true"
              >
                <ellipse cx="12" cy="6" rx="8" ry="3"></ellipse>
                <path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6"></path>
                <path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"></path>
              </svg>
              <div class="min-w-0">
                <p class="text-[15px] font-medium text-primary">{name}</p>
                <p class="mt-0.5 text-[13px] text-muted">{note}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap items-center gap-3" data-reveal>
          <span class="text-[13px] text-muted">Planned:</span>
          {planned.map(({ name }) => (
            <span class="rounded-full border border-dashed border-border-strong px-3 py-1 text-[13px] text-muted">
              {name}
            </span>
          ))}
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2" data-reveal>
          {PLATFORMS.map(({ name, note }) => (
            <div class="flex items-baseline gap-3 rounded-xl border border-border p-6">
              <p class="text-[15px] font-medium text-primary">{name}</p>
              <p class="text-[13px] text-muted">{note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Audience ──────────────────────────────────────────────────────── -->
    <section class="border-t border-border">
