---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

// The "Open JustDB" CTA's href is the `justdb://` URL scheme registered by
// the Tauri build, so the visible action matches the intent. A small client
// script kicks in alongside the native click: if no handler responds within
// ~1.5s (i.e. the app isn't installed and the page stayed visible), we
// redirect to `downloadUrl`. Mobile UAs have no desktop install path, so
// the script swaps the href to `downloadUrl` up-front.
const launchUrl = 'justdb://open';
const repo = 'codellyson/justdb';
const downloadUrl = `https://github.com/${repo}/releases`;

// Resolve direct installer URLs for the latest release at build time so the
// device-detected CTA links straight to the right file. Asset names carry the
// version (e.g. JustDB_0.1.25_x64-setup.exe), so we can't hardcode them — we
// match by extension against the latest release. Any failure or missing asset
// falls back to the releases page.
async function resolveDownloads(): Promise<Record<'macos' | 'windows' | 'linux', string>> {
  const fallback = { macos: downloadUrl, windows: downloadUrl, linux: downloadUrl };
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'justdb-marketing' },
    });
    if (!res.ok) return fallback;
    const { assets = [] } = (await res.json()) as {
      assets?: { name: string; browser_download_url: string }[];
    };
    const find = (re: RegExp) => assets.find((a) => re.test(a.name))?.browser_download_url;
    return {
      macos: find(/\.dmg$/i) ?? downloadUrl,
      // NSIS setup is the standard user installer; .msi is the fallback.
      windows: find(/-setup\.exe$/i) ?? find(/\.msi$/i) ?? downloadUrl,
      // Linux bundles aren't published yet — send them to the releases page.
      linux: downloadUrl,
    };
  } catch {
    return fallback;
  }
}
const downloads = await resolveDownloads();

const FAQ = [
  {
    q: 'Which databases work?',
    a: 'PostgreSQL, MySQL/MariaDB, and SQLite (including libsql/Turso).',
  },
  {
    q: 'Which platforms are supported?',
    a: 'Mac, Windows, and Linux. The desktop app runs natively on all three.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes. No signup, no trial, no paywall. Built by KreativeKorna Concepts.',
  },
];

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'JustDB',
  description:
    'Just your data, no bullshit. A local desktop app for PostgreSQL, MySQL, and SQLite. Browse tables, run queries, inspect schemas. Credentials stay on your machine.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: Astro.site?.toString() ?? 'https://justdb.kreativekorna.com',
  downloadUrl,
  publisher: {
    '@type': 'Organization',
    name: 'KreativeKorna Concepts',
    url: 'https://kreativekorna.com',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout jsonLd={[softwareJsonLd, faqJsonLd]}>
  <div class="min-h-screen bg-bg">
    <main class="container mx-auto px-6 sm:px-8 py-16 sm:py-24">
      <div class="max-w-4xl mx-auto">
        <header class="text-center mb-16">
          <img
            src="/logo.svg"
            alt="JustDB"
            width="64"
            height="64"
            class="mx-auto mb-6"
          />
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-primary mb-4">
            JustDB
          </h1>
          <p class="text-xl sm:text-2xl text-primary font-medium mb-6">
            See your database. Edit it. Query it.
          </p>
          <p class="text-base text-secondary leading-relaxed max-w-xl mx-auto">
            A clean database explorer for PostgreSQL, MySQL, and SQLite. Free,
            no signup.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
            <Button
              variant="primary"
              href={launchUrl}
              id="cta-open-app"
              data-fallback={downloadUrl}
            >
              Open JustDB
            </Button>
            <Button
              variant="secondary"
              href={downloadUrl}
              id="cta-download"
              external
              data-download-macos={downloads.macos}
              data-download-windows={downloads.windows}
              data-download-linux={downloads.linux}
            >
              Download desktop app
            </Button>
          </div>

          <div class="mt-14 sm:mt-16">
            <div class="relative rounded-xl border border-border bg-bg-secondary shadow-2xl shadow-black/20 overflow-hidden aspect-video">
              <!-- `muted` is required for autoplay to be allowed; the clip has
                   no audio track anyway. The screenshot is the poster shown
                   until the first frame decodes. `webkit-playsinline` covers
                   older iOS; the CSS below kills the stubborn native controls
                   iOS injects on the poster. -->
              <video
                id="hero-video"
                class="w-full h-full object-cover"
                poster="/justdb-shot.png"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                disablepictureinpicture
                disableRemotePlayback
                preload="auto"
              >
                <source src="/justdb-demo.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </header>

        <style is:global>
          /* iOS/WebKit paints a big center play glyph over the poster and can
             surface controls even without the `controls` attribute. Nuke both
             so the autoplaying loop stays chrome-free. */
          #hero-video::-webkit-media-controls,
          #hero-video::-webkit-media-controls-start-playback-button,
          #hero-video::-webkit-media-controls-panel {
            display: none !important;
            -webkit-appearance: none;
          }
        </style>

        <section aria-labelledby="how-it-works" class="mb-16 max-w-2xl mx-auto">
          <h2 id="how-it-works" class="text-xl font-semibold text-primary mb-6">
            How it works
          </h2>
          <ol class="space-y-4 text-secondary">
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">
                1
              </span>
              <p>
                <strong class="text-primary">Connect.</strong>
                Paste your connection string and pick a driver.
              </p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">
                2
              </span>
              <p>
                <strong class="text-primary">Browse.</strong>
                Tables, columns, foreign keys, row counts. Pin what you use,
                search the rest.
              </p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">
                3
              </span>
              <p>
                <strong class="text-primary">Edit or query.</strong>
                Inline edits with staged changes, or write SQL in a full editor.
              </p>
            </li>
          </ol>
        </section>

        <section aria-labelledby="faq" class="mb-16 max-w-2xl mx-auto">
          <h2 id="faq" class="text-xl font-semibold text-primary mb-6">
            Frequently asked questions
          </h2>
          <dl class="space-y-6">
            {FAQ.map(({ q, a }) => (
              <div>
                <dt class="text-base font-medium text-primary mb-1.5">{q}</dt>
                <dd class="text-sm text-secondary leading-relaxed">{a}</dd>
              </div>
            ))}
          </dl>
        </section>

        <footer class="pt-8 border-t border-border text-center max-w-2xl mx-auto">
          <p class="text-xs text-muted mb-1">Built by</p>
          <a
            href="https://kreativekorna.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-primary hover:text-accent transition-colors"
          >
            KreativeKorna Concepts
          </a>
          <p class="text-xs text-muted/70 mt-3 flex items-center justify-center gap-3">
            <a href={downloadUrl} class="hover:text-primary transition-colors">
              Get the desktop app
            </a>
            <span class="opacity-50">·</span>
            <a href="/changelog" class="hover:text-primary transition-colors">
              Changelog
            </a>
          </p>
        </footer>
      </div>
    </main>
  </div>

  <script>
    // "Open JustDB" CTA: href is `justdb://open`, so a native click hands
    // the URL to the OS — installed app launches, no JS required.
    //
    // Fallback when nothing's installed: after the click, wait ~1.5s. If
    // the tab is still visible (i.e. the OS didn't hijack focus to launch
    // an app), redirect to the download URL stored in `data-fallback`.
    //
    // On mobile, no desktop app can exist — swap the href to the download
    // URL up-front so the click goes straight there with no protocol noise.
    type OS = 'macos' | 'windows' | 'linux';

    function detectOS(): OS | null {
      // navigator.platform is frozen in modern browsers; prefer the UA-CH hint
      // where available, then fall back to userAgent + platform sniffing.
      const uaData = (navigator as any).userAgentData;
      const hint = `${navigator.userAgent} ${uaData?.platform ?? navigator.platform ?? ''}`;
      if (/Mac|iPhone|iPad|iPod/i.test(hint)) return 'macos';
      if (/Win/i.test(hint)) return 'windows';
      if (/Linux|X11|CrOS/i.test(hint)) return 'linux';
      return null;
    }

    const os = detectOS();
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    const osLabel: Record<OS, string> = {
      macos: 'Download for macOS',
      windows: 'Download for Windows',
      linux: 'Download for Linux',
    };

    // Point the "Download desktop app" button at the detected OS's installer.
    const download = document.getElementById('cta-download');
    let osDownloadUrl: string | undefined;
    if (download instanceof HTMLAnchorElement && os) {
      osDownloadUrl = download.dataset[
        os === 'macos' ? 'downloadMacos' : os === 'windows' ? 'downloadWindows' : 'downloadLinux'
      ];
      if (osDownloadUrl) {
        download.href = osDownloadUrl;
        download.textContent = osLabel[os];
      }
    }

    // "Open JustDB" CTA: href is `justdb://open`, so a native click hands the
    // URL to the OS — installed app launches, no JS required. If nothing's
    // installed, after ~1.5s the tab is still visible (the OS didn't hijack
    // focus), so we redirect to the best download we have. On mobile there's
    // no desktop app to launch, so we swap the href up-front.
    const cta = document.getElementById('cta-open-app');
    if (cta instanceof HTMLAnchorElement) {
      const fallback = osDownloadUrl ?? cta.dataset.fallback;
      if (isMobile) {
        if (fallback) cta.href = fallback;
      } else if (fallback) {
        cta.addEventListener('click', () => {
          window.setTimeout(() => {
            if (!document.hidden) window.location.href = fallback;
          }, 1500);
        });
      }
    }

    // iOS is finicky about muted autoplay: the `muted` attribute alone is
    // sometimes ignored, so set it as a property before calling play(). If the
    // browser still blocks it (e.g. Low Power Mode), fall back to kicking off
    // playback on the first user interaction. The poster stays put until then.
    const hero = document.getElementById('hero-video');
    if (hero instanceof HTMLVideoElement) {
      hero.muted = true;
      const tryPlay = () => hero.play().catch(() => {});
      tryPlay();
      const onFirstInteraction = () => {
        tryPlay();
        window.removeEventListener('touchstart', onFirstInteraction);
        window.removeEventListener('click', onFirstInteraction);
      };
      window.addEventListener('touchstart', onFirstInteraction, { once: true, passive: true });
      window.addEventListener('click', onFirstInteraction, { once: true });
    }
  </script>
</Layout>
