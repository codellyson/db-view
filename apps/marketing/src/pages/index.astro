---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

// The "Open JustDB" CTA tries to launch the installed desktop app via the
// `justdb://` URL scheme (registered by the Tauri build). A small client
// script intercepts the click; if no handler responds within ~1.5s we fall
// through to `downloadUrl` (the desktop release page). The href on the
// element itself IS the fallback — that way JS-disabled visitors land on
// the download page directly, which is the next-best option.
const downloadUrl = 'https://github.com/codellyson/justdb/releases';

const FAQ = [
  {
    q: 'Which databases work?',
    a: 'PostgreSQL, MySQL/MariaDB, and SQLite (including libsql/Turso).',
  },
  {
    q: 'Which platforms are supported?',
    a: 'Mac, Windows, and Linux. The desktop app runs natively on all three.',
  },
  {
    q: 'Where are my credentials stored?',
    a: 'In your operating system keychain (Keychain on macOS, Credential Manager on Windows, libsecret on Linux). Nothing is sent to us.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes. No signup, no trial, no paywall. Built by KreativeKorna Concepts.',
  },
];

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'JustDB',
  description:
    'Just your data, no bullshit. A local desktop app for PostgreSQL, MySQL, and SQLite. Browse tables, run queries, inspect schemas. Credentials stay on your machine.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: Astro.site?.toString() ?? 'https://justdb.kreativekorna.com',
  downloadUrl,
  publisher: {
    '@type': 'Organization',
    name: 'KreativeKorna Concepts',
    url: 'https://kreativekorna.com',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout jsonLd={[softwareJsonLd, faqJsonLd]}>
  <div class="min-h-screen bg-bg">
    <main class="container mx-auto px-6 sm:px-8 py-16 sm:py-24">
      <div class="max-w-2xl mx-auto">
        <header class="text-center mb-16">
          <img
            src="/logo.svg"
            alt="JustDB"
            width="64"
            height="64"
            class="mx-auto mb-6"
          />
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-primary mb-4">
            JustDB
          </h1>
          <p class="text-xl sm:text-2xl text-primary font-medium mb-6">
            See your database. Edit it. Query it.
          </p>
          <p class="text-base text-secondary leading-relaxed max-w-xl mx-auto">
            A clean database explorer for PostgreSQL, MySQL, and SQLite. Free,
            no signup.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
            <Button variant="primary" href={downloadUrl} id="cta-open-app">
              Open JustDB
            </Button>
            <Button
              variant="secondary"
              href={downloadUrl}
              external
            >
              Download desktop app
            </Button>
          </div>
        </header>

        <section aria-labelledby="how-it-works" class="mb-16">
          <h2 id="how-it-works" class="text-xl font-semibold text-primary mb-6">
            How it works
          </h2>
          <ol class="space-y-4 text-secondary">
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">
                1
              </span>
              <p>
                <strong class="text-primary">Connect.</strong>
                Paste your connection string and pick a driver.
              </p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">
                2
              </span>
              <p>
                <strong class="text-primary">Browse.</strong>
                Tables, columns, foreign keys, row counts. Pin what you use,
                search the rest.
              </p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">
                3
              </span>
              <p>
                <strong class="text-primary">Edit or query.</strong>
                Inline edits with staged changes, or write SQL in a full editor.
              </p>
            </li>
          </ol>
        </section>

        <section aria-labelledby="faq" class="mb-16">
          <h2 id="faq" class="text-xl font-semibold text-primary mb-6">
            Frequently asked questions
          </h2>
          <dl class="space-y-6">
            {FAQ.map(({ q, a }) => (
              <div>
                <dt class="text-base font-medium text-primary mb-1.5">{q}</dt>
                <dd class="text-sm text-secondary leading-relaxed">{a}</dd>
              </div>
            ))}
          </dl>
        </section>

        <footer class="pt-8 border-t border-border text-center">
          <p class="text-xs text-muted mb-1">Built by</p>
          <a
            href="https://kreativekorna.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-primary hover:text-accent transition-colors"
          >
            KreativeKorna Concepts
          </a>
          <p class="text-xs text-muted/70 mt-3">
            <a href={downloadUrl} class="hover:text-primary transition-colors">
              Get the desktop app
            </a>
          </p>
        </footer>
      </div>
    </main>
  </div>

  <script>
    // "Open JustDB" CTA: try to launch the installed desktop app via the
    // `justdb://` protocol (registered by the Tauri bundle). If no handler
    // responds, visibility stays on this page and we navigate to the
    // download URL the anchor already points at — so we never leave the
    // visitor stranded.
    //
    // The classic protocol-handler-detection pattern: trigger the scheme,
    // then check `document.hidden` after a short delay. If the OS launched
    // the app, focus left the tab and `hidden` is true → skip the fallback.
    // If nothing handled the scheme, we're still visible → go to download.
    const cta = document.getElementById('cta-open-app');
    if (cta instanceof HTMLAnchorElement) {
      const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (!isMobile) {
        cta.addEventListener('click', (event) => {
          event.preventDefault();
          const fallback = cta.href;
          window.location.href = 'justdb://open';
          window.setTimeout(() => {
            if (!document.hidden) window.location.href = fallback;
          }, 1500);
        });
      }
      // On mobile, leave the anchor alone — the href already points at the
      // releases page, which is the only sensible destination there.
    }
  </script>
</Layout>
