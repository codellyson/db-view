<script>
  // ── Download / launch CTAs ───────────────────────────────────────────────
  //
  // "Open JustDB" points at `justdb://open`, so a native click hands the URL to
  // the OS and an installed app launches with no JS involved. If nothing is
  // registered, the tab stays visible — after ~1.5s we send them to the best
  // download we have. Mobile has no desktop app to launch, so the href is
  // swapped up-front.
  type OS = 'macos' | 'windows' | 'linux';

  function detectOS(): OS | null {
    // navigator.platform is frozen in modern browsers; prefer the UA-CH hint
    // where available, then fall back to userAgent + platform sniffing.
    const uaData = (navigator as any).userAgentData;
    const hint = `${navigator.userAgent} ${uaData?.platform ?? navigator.platform ?? ''}`;
    if (/Mac|iPhone|iPad|iPod/i.test(hint)) return 'macos';
    if (/Win/i.test(hint)) return 'windows';
    if (/Linux|X11|CrOS/i.test(hint)) return 'linux';
    return null;
  }

  const os = detectOS();
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const osLabel: Record<OS, string> = {
    macos: 'Download for macOS',
    windows: 'Download for Windows',
    linux: 'Download for Linux',
  };

  const download = document.getElementById('cta-download');
  let osDownloadUrl: string | undefined;
  if (download instanceof HTMLAnchorElement && os) {
    osDownloadUrl = download.dataset[
      os === 'macos' ? 'downloadMacos' : os === 'windows' ? 'downloadWindows' : 'downloadLinux'
    ];
    if (osDownloadUrl) {
      download.href = osDownloadUrl;
      download.textContent = osLabel[os];
    }
  }

  for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-fallback]')) {
    const fallback = osDownloadUrl ?? el.dataset.fallback;
    if (!fallback) continue;
    if (isMobile) {
      el.href = fallback;
      continue;
    }
    el.addEventListener('click', () => {
      window.setTimeout(() => {
        if (!document.hidden) window.location.href = fallback;
      }, 1500);
    });
  }

  // ── Scroll reveal ────────────────────────────────────────────────────────
  const targets = document.querySelectorAll('[data-reveal]');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (!entry.isIntersecting) return;
          // Stagger siblings that cross the threshold together so a grid
          // cascades in rather than popping as one block.
          (entry.target as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 55}ms`;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
