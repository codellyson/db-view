strict-dep-builds=false
registry=https://registry.npmjs.org/

# Hoist tslib to the workspace root so wrangler's transitive `capnp-ts`
# dep (which declares tslib as a peer, not a dep) can resolve it via the
# normal node_modules walk. Without this, `wrangler --version` crashes
# with `Cannot find module 'tslib'` inside the Cloudflare Pages deploy
# step. https://github.com/cloudflare/workers-sdk/issues/5701
public-hoist-pattern[]=tslib
